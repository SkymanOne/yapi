[package]
name = "{{project-name}}"
version = "0.1.0"
edition = "2024"

[lib]
crate-type = ["cdylib"]

[dependencies]
# Each feature declares a capability the extension uses and enables the
# requests that need it: `fs`, `net`, `env`, `session`, or `all`.
yapi-extension-api = { version = "0.3.1", features = ["session"] }

[profile.release]
codegen-units = 1
lto = true
opt-level = "s"
strip = true
